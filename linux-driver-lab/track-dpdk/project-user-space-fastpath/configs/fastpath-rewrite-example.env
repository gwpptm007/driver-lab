# Example rewrite policy. Source this before run scripts when you want
# to exercise the rewrite code path.
export FASTPATH_UDP_ONLY=1
export FASTPATH_REWRITE_ENABLE=1
export FASTPATH_EXTRA_APP_ARGS="--rewrite-src-ip 10.10.1.10 --rewrite-dst-ip 10.10.2.20 --rewrite-src-port 5000 --rewrite-dst-port 6000"
