# Default config for the current VMware test machine.
export DPDK_IF=ens192
export DPDK_PCI=0000:0b:00.0
export DPDK_DRIVER=uio_pci_generic
export MGMT_IF=ens33
export MGMT_PCI=0000:02:01.0
export HUGEPAGES=1024
export HUGEPAGE_MOUNT=/mnt/huge
export FASTPATH_LCORES=0-1
export FASTPATH_MEMORY_CHANNELS=4
export FASTPATH_FILE_PREFIX=fastpath_lite
export FASTPATH_RUN_SECONDS=20
export FASTPATH_STATS_PERIOD=2
export FASTPATH_BURST_SIZE=32
export FASTPATH_PROMISC=1
export FASTPATH_UDP_ONLY=1
export FASTPATH_REWRITE_ENABLE=0
