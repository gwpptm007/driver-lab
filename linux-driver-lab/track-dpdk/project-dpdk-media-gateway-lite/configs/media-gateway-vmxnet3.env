# media-gateway-lite VMware test machine defaults
DPDK_IF=ens192
DPDK_PCI=0000:0b:00.0
DPDK_DRIVER=uio_pci_generic
MGMT_IF=ens33
MGMT_PCI=0000:02:01.0
HUGEPAGES=1024

MEDIA_RUN_SECONDS=20
MEDIA_STATS_PERIOD=2
MEDIA_LCORES=0-1
MEDIA_MEMORY_CHANNELS=4
MEDIA_BURST_SIZE=32
MEDIA_UDP_ONLY=1
MEDIA_SWAP_MAC=1
MEDIA_PROMISC=1
