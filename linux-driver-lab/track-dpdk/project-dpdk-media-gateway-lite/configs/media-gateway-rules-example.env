# Example bidirectional media gateway rule set.
# Scripts convert these values into media-gateway-lite command-line options.

RULE0_DIR=0:1
RULE0_NAME=access_to_core
RULE0_DST_PORT=9000
RULE0_REWRITE_DST_MAC=52:54:00:00:00:02
RULE0_REWRITE_DST_IP=10.10.20.20
RULE0_REWRITE_DST_PORT=10000

RULE1_DIR=1:0
RULE1_NAME=core_to_access
RULE1_DST_PORT=10000
RULE1_REWRITE_DST_MAC=52:54:00:00:00:01
RULE1_REWRITE_DST_IP=10.10.10.10
RULE1_REWRITE_DST_PORT=9000
