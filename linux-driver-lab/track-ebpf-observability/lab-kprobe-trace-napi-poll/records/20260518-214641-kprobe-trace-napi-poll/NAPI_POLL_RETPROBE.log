This retprobe dynamically selects the first traceable NAPI poll symbol.

## selected probe
kretprobe:__napi_poll

## generated script
kretprobe:__napi_poll
{
    @napi_poll_returns[probe, retval] = count();
    @napi_poll_ret_by_cpu[probe, cpu, retval] = count();
}

interval:s:1
{
    print(@napi_poll_returns);
    print(@napi_poll_ret_by_cpu);
}

