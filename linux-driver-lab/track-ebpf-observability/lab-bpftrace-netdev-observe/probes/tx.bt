tracepoint:net:net_dev_queue
{
  @tx_queue_total = count();
  @tx_queue_cpu[cpu] = count();
}

tracepoint:net:net_dev_xmit
{
  @tx_xmit_total = count();
  @tx_xmit_cpu[cpu] = count();
}

interval:s:1
{
  time("%H:%M:%S ");
  print(@tx_queue_total);
  print(@tx_xmit_total);
  print(@tx_queue_cpu);
  print(@tx_xmit_cpu);
}
