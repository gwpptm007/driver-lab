#!/usr/bin/env bash
# day22.env
#
# day22 从这一版开始默认使用 ivshmem-plain：
# - D22 只做 PCI 设备可见性 / BAR 基本观察 / lspci 证据归档
# - 不再强依赖 ivshmem-server
# - 到 D25 再决定是否切到能更自然承载中断实验的后端

export DAY22_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export LAB_ROOT="$(cd "${DAY22_ROOT}/.." && pwd)"
export REPO_ROOT="$(cd "${LAB_ROOT}/.." && pwd)"

export WORKDIR="${WORKDIR:-${DAY22_ROOT}/workdir}"
export ROOTFS_DIR="${ROOTFS_DIR:-${WORKDIR}/rootfs}"
export ROOTFS_IMAGE="${ROOTFS_IMAGE:-${WORKDIR}/rootfs.img}"
export TOOLS_DIR="${TOOLS_DIR:-${WORKDIR}/tools}"
export RUNS_DIR="${RUNS_DIR:-${WORKDIR}/runs}"

export QEMU_BIN="${QEMU_BIN:-qemu-system-aarch64}"
export CPIO_BIN="${CPIO_BIN:-cpio}"
export GZIP_BIN="${GZIP_BIN:-gzip}"
export TIMEOUT_BIN="${TIMEOUT_BIN:-timeout}"
export AWK_BIN="${AWK_BIN:-awk}"
export GREP_BIN="${GREP_BIN:-grep}"
export SED_BIN="${SED_BIN:-sed}"
export FILE_BIN="${FILE_BIN:-file}"
export TRUNCATE_BIN="${TRUNCATE_BIN:-truncate}"
export STAT_BIN="${STAT_BIN:-stat}"

export ARCH="${ARCH:-arm64}"
export CROSS_COMPILE="${CROSS_COMPILE:-aarch64-linux-gnu-}"
export CC="${CC:-${CROSS_COMPILE}gcc}"
export AR="${AR:-${CROSS_COMPILE}ar}"
export RANLIB="${RANLIB:-${CROSS_COMPILE}ranlib}"
export STRIP="${STRIP:-${CROSS_COMPILE}strip}"
export PCIUTILS_HOST="${PCIUTILS_HOST:-aarch64-linux-gnu}"
export HOST_CC="${HOST_CC:-gcc}"
export HOST_STRIP="${HOST_STRIP:-strip}"

export KERNEL_IMAGE="${KERNEL_IMAGE:-}"
export KERNEL_CONFIG_PATH="${KERNEL_CONFIG_PATH:-}"
export BUSYBOX_BIN="${BUSYBOX_BIN:-}"
export GUEST_LSPCI_BIN="${GUEST_LSPCI_BIN:-${TOOLS_DIR}/aarch64/lspci}"
export PCIUTILS_SRC_DIR="${PCIUTILS_SRC_DIR:-${DAY22_ROOT}/third_party/pciutils}"
export GUEST_PCI_SYSFS_DUMP_BIN="${GUEST_PCI_SYSFS_DUMP_BIN:-${TOOLS_DIR}/aarch64/pci_sysfs_dump}"

export QEMU_MACHINE="${QEMU_MACHINE:-virt}"
export QEMU_CPU="${QEMU_CPU:-cortex-a57}"
export QEMU_MEMORY_MB="${QEMU_MEMORY_MB:-1024}"
export QEMU_APPEND="${QEMU_APPEND:-console=ttyAMA0 rdinit=/init loglevel=8 printk.devkmsg=on}"
export QEMU_TIMEOUT_SEC="${QEMU_TIMEOUT_SEC:-120}"
export QEMU_ACCEL="${QEMU_ACCEL:-tcg,thread=multi}"

# D22 默认后端：ivshmem-plain + memory-backend-file
export IVSHMEM_SIZE="${IVSHMEM_SIZE:-4M}"
export IVSHMEM_DEVICE_ID_EXPECT="${IVSHMEM_DEVICE_ID_EXPECT:-1af4:1110}"
export IVSHMEM_BACKEND_FILENAME="${IVSHMEM_BACKEND_FILENAME:-ivshmem-day22.bin}"

export RUN_ID="${RUN_ID:-$(date +%Y%m%d-%H%M%S)}"
