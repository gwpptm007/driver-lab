# Day25 默认环境变量

export RUN_ID ?= day25-local-001

export ARCH ?= arm64
export CROSS_COMPILE ?= aarch64-linux-gnu-
export HOST_CC ?= gcc

export QEMU_BIN ?= qemu-system-aarch64
export WORKDIR ?= ${DAY25_ROOT}/workdir
export RECORDS_DIR ?= ${DAY25_ROOT}/records

export PCIUTILS_SRC_DIR ?= ${DAY25_ROOT}/third_party/pciutils
export GUEST_LSPCI_BIN ?= ${PCIUTILS_SRC_DIR}/lspci
export GUEST_TOOL_BIN ?= ${WORKDIR}/tools/aarch64/day25_irq_tool

export ROOTFS_DIR ?= ${WORKDIR}/rootfs
export ROOTFS_IMG ?= ${WORKDIR}/rootfs.img

export QEMU_MACHINE ?= virt
export QEMU_CPU ?= cortex-a57
export QEMU_MEM ?= 512M

export EDU_DEVICE_ID_EXPECT ?= 1234:11e8

# EDU MMIO offsets (see QEMU EDU spec)
export EDU_REG_ID ?= 0x00
export EDU_REG_LIVENESS ?= 0x04
export EDU_REG_STATUS ?= 0x20
export EDU_REG_IRQ_STATUS ?= 0x24
export EDU_REG_IRQ_RAISE ?= 0x60
export EDU_REG_IRQ_ACK ?= 0x64
