# stage01_netdev_skeleton
# 这一阶段保持架构中立，不把 arm64 / qemu 写死。

TARGET_ARCH ?= host
RUN_MODE ?= host
HOST_CC ?= gcc

# 模块构建相关
KDIR ?= /lib/modules/$(shell uname -r)/build
MODULE_NAME ?= netdev_stage01
IFNAME ?= nds0

# 运行与脚本相关
IP_BIN ?= ip
MODPROBE_BIN ?= modprobe
INSMOD_BIN ?= insmod
RMMOD_BIN ?= rmmod
SUDO ?= sudo
DEBUGFS_MOUNT ?= /sys/kernel/debug
DEBUGFS_STATS ?= /sys/kernel/debug/netdev_stage01/stats
