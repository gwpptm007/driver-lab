# stage02_skb_path
# 这一阶段保持架构中立，不把 arm64 / qemu 写死。

TARGET_ARCH ?= host
RUN_MODE ?= host
HOST_CC ?= gcc

KDIR ?= /lib/modules/$(shell uname -r)/build
MODULE_NAME ?= netdev_stage02
IFNAME ?= nds2
LOOP_MODE ?= copy
ETHERTYPE ?= 0x88B5

IP_BIN ?= ip
INSMOD_BIN ?= insmod
RMMOD_BIN ?= rmmod
SUDO ?= sudo
TIMEOUT_BIN ?= timeout
DEBUGFS_MOUNT ?= /sys/kernel/debug
DEBUGFS_STATS ?= /sys/kernel/debug/netdev_stage02/stats
