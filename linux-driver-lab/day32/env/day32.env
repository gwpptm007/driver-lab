#!/usr/bin/env bash
export DAY32_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export LAB_ROOT="$(cd "${DAY32_ROOT}/.." && pwd)"
export PROJECT_ROOT="$(cd "${LAB_ROOT}/.." && pwd)"

export WORKDIR="${DAY32_ROOT}/workdir"
export ROOTFS_DIR="${WORKDIR}/rootfs"
export ROOTFS_IMG="${WORKDIR}/rootfs.img"
export RECORDS_DIR="${DAY32_ROOT}/records"
export OUTPUT_DIR="${DAY32_ROOT}/output"

export RUN_ID="${RUN_ID:-day32-local-001}"
export QEMU_BIN="${QEMU_BIN:-qemu-system-aarch64}"
export QEMU_MACHINE="${QEMU_MACHINE:-virt}"
export QEMU_CPU="${QEMU_CPU:-cortex-a57}"
export QEMU_MEM="${QEMU_MEM:-512M}"
# Day32 默认需要完整跑完 baseline/optimized/compare/ioctl/dma-lite，
# 因此超时预算比 day31 更宽。
export QEMU_TIMEOUT_SEC="${QEMU_TIMEOUT_SEC:-240}"

export ARCH="${ARCH:-arm64}"
export CROSS_COMPILE="${CROSS_COMPILE:-aarch64-linux-gnu-}"
export HOST_CC="${HOST_CC:-gcc}"

export KERNEL_SRC_ROOT="${KERNEL_SRC_ROOT:-${PROJECT_ROOT}/kernel-src/linux-5.15.10/src}"
export KDIR="${KDIR:-${PROJECT_ROOT}/kernel-src/linux-5.15.10/build/arm64}"
export KERNEL_IMAGE="${KERNEL_IMAGE:-${PROJECT_ROOT}/kernel-src/linux-5.15.10/build/arm64/arch/arm64/boot/Image}"
export KERNEL_CONFIG_PATH="${KERNEL_CONFIG_PATH:-${PROJECT_ROOT}/kernel-src/linux-5.15.10/build/arm64/.config}"
export BUSYBOX_BIN="${BUSYBOX_BIN:-${PROJECT_ROOT}/kernel-src/busybox-1.36.1/build/arm64/busybox}"

export PCIUTILS_SRC_DIR="${PCIUTILS_SRC_DIR:-${DAY32_ROOT}/third_party/pciutils}"
export GUEST_LSPCI_BIN="${GUEST_LSPCI_BIN:-${PCIUTILS_SRC_DIR}/lspci}"
export PCIUTILS_GIT_URL="${PCIUTILS_GIT_URL:-https://github.com/pciutils/pciutils.git}"

export EDU_DEVICE_ID_EXPECT="${EDU_DEVICE_ID_EXPECT:-1234:11e8}"
export EDU_QEMU_DMA_MASK="${EDU_QEMU_DMA_MASK:-0xffffffff}"

# Day32 关注 perf 与优化点，因此区分“功能校验参数”和“perf workload 参数”。
# 其中 PERF_* 是 compare-mmap 与 perf-baseline/perf-optimized 共用的一套固定 workload。
export DAY32_VERIFY_LEN="${DAY32_VERIFY_LEN:-256}"
export DAY32_VERIFY_SEED="${DAY32_VERIFY_SEED:-0x41}"
export DAY32_PERF_LEN="${DAY32_PERF_LEN:-256}"
export DAY32_PERF_SEED="${DAY32_PERF_SEED:-0x41}"
export DAY32_PERF_ITER="${DAY32_PERF_ITER:-1000}"
export DAY32_PERF_WARMUP="${DAY32_PERF_WARMUP:-100}"
export DAY32_DMA_LITE_LEN="${DAY32_DMA_LITE_LEN:-64}"
export DAY32_DMA_LITE_ITER="${DAY32_DMA_LITE_ITER:-32}"
export DAY32_DMA_LITE_WARMUP="${DAY32_DMA_LITE_WARMUP:-4}"
export DAY32_PROFILE_MODE="${DAY32_PROFILE_MODE:-full}"
export DAY32_RUN_DMA_LITE="${DAY32_RUN_DMA_LITE:-1}"
