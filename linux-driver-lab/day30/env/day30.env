#!/usr/bin/env bash
export DAY30_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export LAB_ROOT="$(cd "${DAY30_ROOT}/.." && pwd)"
export PROJECT_ROOT="$(cd "${LAB_ROOT}/.." && pwd)"

export WORKDIR="${DAY30_ROOT}/workdir"
export ROOTFS_DIR="${WORKDIR}/rootfs"
export ROOTFS_IMG="${WORKDIR}/rootfs.img"
export RECORDS_DIR="${DAY30_ROOT}/records"

export RUN_ID="${RUN_ID:-day30-local-001}"
export QEMU_BIN="${QEMU_BIN:-qemu-system-aarch64}"
export QEMU_MACHINE="${QEMU_MACHINE:-virt}"
export QEMU_CPU="${QEMU_CPU:-cortex-a57}"
export QEMU_MEM="${QEMU_MEM:-512M}"
export QEMU_TIMEOUT_SEC="${QEMU_TIMEOUT_SEC:-120}"

export ARCH="${ARCH:-arm64}"
export CROSS_COMPILE="${CROSS_COMPILE:-aarch64-linux-gnu-}"
export HOST_CC="${HOST_CC:-gcc}"

export KERNEL_SRC_ROOT="${KERNEL_SRC_ROOT:-${PROJECT_ROOT}/kernel-src/linux-5.15.10/src}"
export KDIR="${KDIR:-${PROJECT_ROOT}/kernel-src/linux-5.15.10/build/arm64}"
export KERNEL_IMAGE="${KERNEL_IMAGE:-${PROJECT_ROOT}/kernel-src/linux-5.15.10/build/arm64/arch/arm64/boot/Image}"
export KERNEL_CONFIG_PATH="${KERNEL_CONFIG_PATH:-${PROJECT_ROOT}/kernel-src/linux-5.15.10/build/arm64/.config}"
export BUSYBOX_BIN="${BUSYBOX_BIN:-${PROJECT_ROOT}/kernel-src/busybox-1.36.1/build/arm64/busybox}"

export PCIUTILS_SRC_DIR="${PCIUTILS_SRC_DIR:-${DAY30_ROOT}/third_party/pciutils}"
export GUEST_LSPCI_BIN="${GUEST_LSPCI_BIN:-${PCIUTILS_SRC_DIR}/lspci}"

export EDU_DEVICE_ID_EXPECT="${EDU_DEVICE_ID_EXPECT:-1234:11e8}"
export EDU_QEMU_DMA_MASK="${EDU_QEMU_DMA_MASK:-0xffffffff}"
export DAY30_VERIFY_LEN="${DAY30_VERIFY_LEN:-256}"
export DAY30_VERIFY_SEED="${DAY30_VERIFY_SEED:-0x41}"
