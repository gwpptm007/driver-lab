# 复制为 env/local.env 或你自己的名字，然后 source 这份文件
export ARCH=arm64
export CROSS_COMPILE=aarch64-linux-gnu-

export RUN_ID=day22-local-001

# 你的内核源码根目录（注意有些仓库是 .../src）
export KERNEL_SRC_ROOT=/path/to/linux-src

# 你的 arm64 build 输出目录
export KDIR=/path/to/linux-build-arm64

# arm64 内核镜像与配置
export KERNEL_IMAGE=/path/to/linux-build-arm64/arch/arm64/boot/Image
export KERNEL_CONFIG_PATH=/path/to/linux-build-arm64/.config

# arm64 BusyBox
export BUSYBOX_BIN=/path/to/arm64/busybox

# 第三方 pciutils 源码目录与 arm64 lspci
export PCIUTILS_SRC_DIR=/path/to/day22/third_party/pciutils
export GUEST_LSPCI_BIN=/path/to/day22/third_party/pciutils/lspci
