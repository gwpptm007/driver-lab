# wq7 本机推荐覆盖文件：与前面 day27~day31 的实际目录布局保持一致。
# 使用方式：
#   source env/day31.env
#   source env/local_wq7.env

export RUN_ID=day31-local-001

export KERNEL_SRC_ROOT=/home/wq7/workspace/driver-lab/kernel-src/linux-5.15.10/src
export KDIR=/home/wq7/workspace/driver-lab/kernel-src/linux-5.15.10/build/arm64
export KERNEL_IMAGE=/home/wq7/workspace/driver-lab/kernel-src/linux-5.15.10/build/arm64/arch/arm64/boot/Image
export KERNEL_CONFIG_PATH=/home/wq7/workspace/driver-lab/kernel-src/linux-5.15.10/build/arm64/.config
export BUSYBOX_BIN=/home/wq7/workspace/driver-lab/kernel-src/busybox-1.36.1/build/arm64/busybox

# 若 day29/day30 已经构建过 arm64 静态 lspci，直接复用即可，不必在 day31 重复编译。
export PCIUTILS_SRC_DIR=/home/wq7/workspace/driver-lab/linux-driver-lab/day31/third_party/pciutils
export GUEST_LSPCI_BIN=/home/wq7/workspace/driver-lab/linux-driver-lab/day29/third_party/pciutils/lspci

export ARCH=arm64
export CROSS_COMPILE=aarch64-linux-gnu-
export EDU_QEMU_DMA_MASK=0xffffffff
export DAY31_VERIFY_LEN=256
export DAY31_VERIFY_SEED=0x41
export DAY31_BENCH_ITER=200
export DAY31_BENCH_WARMUP=20

# 当前 day31 默认采用 200/20 的 bench 规模，并把 timeout 提到 360s。
# bench-all 默认不自动执行；若要跑完整矩阵，可显式设置 DAY31_RUN_BENCH_ALL=1。
export QEMU_TIMEOUT_SEC=360

export DAY31_RUN_BENCH_ALL=0

# 这组默认值已经对应当前包内通过的 records/day31-local-001。
# 若后续想补跑 bench-all，再额外 export DAY31_RUN_BENCH_ALL=1。
