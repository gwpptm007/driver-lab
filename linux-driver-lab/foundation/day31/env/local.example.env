# 复制为 local.<yourname>.env 后按本机真实路径填写，再 source 使用。
# 若你本机目录就是 wq7 这套路径，也可以直接 source env/local_wq7.env。
export RUN_ID=day31-local-001

export KERNEL_SRC_ROOT=/path/to/driver-lab/kernel-src/linux-5.15.10/src
export KDIR=/path/to/driver-lab/kernel-src/linux-5.15.10/build/arm64
export KERNEL_IMAGE=/path/to/driver-lab/kernel-src/linux-5.15.10/build/arm64/arch/arm64/boot/Image
export KERNEL_CONFIG_PATH=/path/to/driver-lab/kernel-src/linux-5.15.10/build/arm64/.config
export BUSYBOX_BIN=/path/to/driver-lab/kernel-src/busybox-1.36.1/build/arm64/busybox

# 可以直接复用 day29/day30 已经构建好的 guest lspci。
export PCIUTILS_SRC_DIR=/path/to/driver-lab/linux-driver-lab/day31/third_party/pciutils
export GUEST_LSPCI_BIN=/path/to/driver-lab/linux-driver-lab/day29/third_party/pciutils/lspci

export ARCH=arm64
export CROSS_COMPILE=aarch64-linux-gnu-
export EDU_QEMU_DMA_MASK=0xffffffff
export DAY31_VERIFY_LEN=256
export DAY31_VERIFY_SEED=0x41
export DAY31_BENCH_ITER=200
export DAY31_BENCH_WARMUP=20

export DAY31_RUN_BENCH_ALL=0

# 可选：若要跑完整矩阵，再显式打开 bench-all。
# export DAY31_RUN_BENCH_ALL=1
