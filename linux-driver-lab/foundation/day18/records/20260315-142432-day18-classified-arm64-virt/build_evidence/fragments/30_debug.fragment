# Day18 30_debug.fragment
# -----------------------
# 分类：调试项（可观测性）
# 目标：让 debugfs / tracing / function_graph / 配置自解释能力保留下来。

CONFIG_DEBUG_FS=y
CONFIG_KALLSYMS=y
CONFIG_KALLSYMS_ALL=y
CONFIG_TRACEPOINTS=y
CONFIG_TRACING=y
CONFIG_FTRACE=y
CONFIG_FUNCTION_TRACER=y
CONFIG_FUNCTION_GRAPH_TRACER=y
CONFIG_DYNAMIC_FTRACE=y
CONFIG_TRACEFS_FS=y
CONFIG_FRAME_POINTER=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
