#!/usr/bin/env bash
# Day35 是离线汇总日，不依赖新的 guest 启动。
# 这里主要提供仓库根目录与输出目录路径，供汇总脚本统一使用。
export DAY35_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export LAB_ROOT="$(cd "${DAY35_ROOT}/.." && pwd)"
export OUTPUT_DIR="${DAY35_ROOT}/output"
export RECORDS_DIR="${DAY35_ROOT}/records"
export RUN_ID="${RUN_ID:-day35-local-001}"
