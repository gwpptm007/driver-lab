# WQ7 本机覆盖示例：按当前 driver-lab 目录布局填写。
export RUN_ID=day32-local-001
export KERNEL_SRC_ROOT=/home/wq7/workspace/driver-lab/kernel-src/linux-5.15.10/src
export KDIR=/home/wq7/workspace/driver-lab/kernel-src/linux-5.15.10/build/arm64
export KERNEL_IMAGE=/home/wq7/workspace/driver-lab/kernel-src/linux-5.15.10/build/arm64/arch/arm64/boot/Image
export KERNEL_CONFIG_PATH=/home/wq7/workspace/driver-lab/kernel-src/linux-5.15.10/build/arm64/.config
export BUSYBOX_BIN=/home/wq7/workspace/driver-lab/kernel-src/busybox-1.36.1/build/arm64/busybox
export PCIUTILS_SRC_DIR=/home/wq7/workspace/driver-lab/linux-driver-lab/day32/third_party/pciutils
export GUEST_LSPCI_BIN=/home/wq7/workspace/driver-lab/linux-driver-lab/day31/third_party/pciutils/lspci
export ARCH=arm64
export CROSS_COMPILE=aarch64-linux-gnu-
export QEMU_TIMEOUT_SEC=240
export DAY32_PERF_LEN=256
export DAY32_PERF_ITER=1000
export DAY32_PERF_WARMUP=100
export DAY32_DMA_LITE_LEN=64
export DAY32_DMA_LITE_ITER=32
export DAY32_DMA_LITE_WARMUP=4
export DAY32_PROFILE_MODE=full
export DAY32_RUN_DMA_LITE=1
