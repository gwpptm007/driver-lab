#!/usr/bin/env bash
export DAY26_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export WORKDIR="${DAY26_ROOT}/workdir"
export ROOTFS_DIR="${WORKDIR}/rootfs"
export ROOTFS_IMG="${WORKDIR}/rootfs.img"
export RECORDS_DIR="${DAY26_ROOT}/records"

export RUN_ID="${RUN_ID:-day26-local-001}"
export QEMU_BIN="${QEMU_BIN:-qemu-system-aarch64}"
export QEMU_MACHINE="${QEMU_MACHINE:-virt}"
export QEMU_CPU="${QEMU_CPU:-cortex-a57}"
export QEMU_MEM="${QEMU_MEM:-512M}"

export ARCH="${ARCH:-arm64}"
export CROSS_COMPILE="${CROSS_COMPILE:-aarch64-linux-gnu-}"
export PCIUTILS_SRC_DIR="${PCIUTILS_SRC_DIR:-${DAY26_ROOT}/third_party/pciutils}"
export GUEST_LSPCI_BIN="${GUEST_LSPCI_BIN:-${PCIUTILS_SRC_DIR}/lspci}"
export EDU_DEVICE_ID_EXPECT="${EDU_DEVICE_ID_EXPECT:-1234:11e8}"
