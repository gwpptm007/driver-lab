# Day26 本地环境模板
#
# 用法：
#   cd ~/workspace/driver-lab/linux-driver-lab/day26
#   cp env/local.example.env env/local.my.env
#   vim env/local.my.env
#   source env/local.my.env
#
# 说明：这里不包含第三方源码获取命令；pciutils 的获取与编译写在 README / START_HERE /
# docs/01_LOCAL_RUNBOOK.md 的主流程里。
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/day26.env"

export RUN_ID=day26-local-001
export KERNEL_SRC_ROOT=/path/to/linux-src/src
export KDIR=/path/to/linux-build/arm64
export KERNEL_IMAGE=/path/to/linux-build/arm64/arch/arm64/boot/Image
export KERNEL_CONFIG_PATH=/path/to/linux-build/arm64/.config
export BUSYBOX_BIN=/path/to/busybox-arm64/busybox
