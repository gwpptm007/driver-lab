export RUN_ID=day33-local-001
export KERNEL_SRC_ROOT=/path/to/driver-lab/kernel-src/linux-5.15.10/src
export KDIR=/path/to/driver-lab/kernel-src/linux-5.15.10/build/arm64
export KERNEL_IMAGE=/path/to/driver-lab/kernel-src/linux-5.15.10/build/arm64/arch/arm64/boot/Image
export KERNEL_CONFIG_PATH=/path/to/driver-lab/kernel-src/linux-5.15.10/build/arm64/.config
export BUSYBOX_BIN=/path/to/driver-lab/kernel-src/busybox-1.36.1/build/arm64/busybox
export PCIUTILS_SRC_DIR=/path/to/driver-lab/linux-driver-lab/day33/third_party/pciutils
export GUEST_LSPCI_BIN=/path/to/driver-lab/linux-driver-lab/day33/third_party/pciutils/lspci
export ARCH=arm64
export CROSS_COMPILE=aarch64-linux-gnu-
export QEMU_TIMEOUT_SEC=180
export DAY33_VERIFY_LEN=256
export DAY33_VERIFY_SEED=0x41
export DAY33_TRACE_LEN=64
export DAY33_TRACE_SEED=0x55
export DAY33_TRACE_WORKLOAD=verify
export DAY33_TRACE_DMA_ITER=2
export DAY33_TRACE_DMA_WARMUP=0
