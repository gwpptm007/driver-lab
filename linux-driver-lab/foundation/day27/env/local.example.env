# 复制为 local.<yourname>.env 后按本机真实路径填写，再 source 使用。
export RUN_ID=day27-local-001
export KERNEL_SRC_ROOT=/path/to/kernel-src/linux-5.15.10/src
export KDIR=/path/to/kernel-src/linux-5.15.10/build/arm64
export KERNEL_IMAGE=/path/to/kernel-src/linux-5.15.10/build/arm64/arch/arm64/boot/Image
export KERNEL_CONFIG_PATH=/path/to/kernel-src/linux-5.15.10/build/arm64/.config
export BUSYBOX_BIN=/path/to/busybox/build/arm64/busybox
export PCIUTILS_SRC_DIR=/path/to/linux-driver-lab/day27/third_party/pciutils
export GUEST_LSPCI_BIN=/path/to/linux-driver-lab/day27/third_party/pciutils/lspci
export ARCH=arm64
export CROSS_COMPILE=aarch64-linux-gnu-
export DAY27_LOOP_COUNT=200
