# day23 默认环境变量

RUN_ID="${RUN_ID:-day23-local-001}"

DAY23_ROOT="${DAY23_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
WORKDIR="${WORKDIR:-${DAY23_ROOT}/workdir}"
REPO_ROOT="${REPO_ROOT:-$(cd "${DAY23_ROOT}/.." && pwd)}"

ARCH="${ARCH:-arm64}"
CROSS_COMPILE="${CROSS_COMPILE:-aarch64-linux-gnu-}"
HOST_CC="${HOST_CC:-gcc}"

QEMU_BIN="${QEMU_BIN:-qemu-system-aarch64}"
KERNEL_SRC_ROOT="${KERNEL_SRC_ROOT:-${REPO_ROOT}/../kernel-src/linux-5.15.10/src}"
KDIR="${KDIR:-${REPO_ROOT}/../kernel-src/linux-5.15.10/build/arm64}"
KERNEL_IMAGE="${KERNEL_IMAGE:-${KDIR}/arch/arm64/boot/Image}"
KERNEL_CONFIG_PATH="${KERNEL_CONFIG_PATH:-${KDIR}/.config}"
BUSYBOX_BIN="${BUSYBOX_BIN:-${REPO_ROOT}/../kernel-src/busybox-1.36.1/build/arm64/busybox}"

PCIUTILS_SRC_DIR="${PCIUTILS_SRC_DIR:-${DAY23_ROOT}/third_party/pciutils}"
GUEST_LSPCI_BIN="${GUEST_LSPCI_BIN:-${PCIUTILS_SRC_DIR}/lspci}"

IVSHMEM_SIZE="${IVSHMEM_SIZE:-4M}"
IVSHMEM_DEVICE_ID_EXPECT="${IVSHMEM_DEVICE_ID_EXPECT:-1af4:1110}"
IVSHMEM_BACKEND_FILE="${IVSHMEM_BACKEND_FILE:-${WORKDIR}/runs/${RUN_ID}/ivshmem-day23.bin}"

MODULE_NAME="${MODULE_NAME:-day23_ivshmem_probe}"
MODULE_FILE="${MODULE_FILE:-${DAY23_ROOT}/driver/day23_ivshmem_probe.ko}"
