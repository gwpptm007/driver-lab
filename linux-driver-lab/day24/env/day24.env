# day24 默认环境变量

RUN_ID="${RUN_ID:-day24-local-001}"

DAY24_ROOT="${DAY24_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
WORKDIR="${WORKDIR:-${DAY24_ROOT}/workdir}"
REPO_ROOT="${REPO_ROOT:-$(cd "${DAY24_ROOT}/.." && pwd)}"

ARCH="${ARCH:-arm64}"
CROSS_COMPILE="${CROSS_COMPILE:-aarch64-linux-gnu-}"
HOST_CC="${HOST_CC:-gcc}"
HOST_STRIP="${HOST_STRIP:-strip}"

QEMU_BIN="${QEMU_BIN:-qemu-system-aarch64}"
KERNEL_SRC_ROOT="${KERNEL_SRC_ROOT:-${REPO_ROOT}/../kernel-src/linux-5.15.10/src}"
KDIR="${KDIR:-${REPO_ROOT}/../kernel-src/linux-5.15.10/build/arm64}"
KERNEL_IMAGE="${KERNEL_IMAGE:-${KDIR}/arch/arm64/boot/Image}"
KERNEL_CONFIG_PATH="${KERNEL_CONFIG_PATH:-${KDIR}/.config}"
BUSYBOX_BIN="${BUSYBOX_BIN:-${REPO_ROOT}/../kernel-src/busybox-1.36.1/build/arm64/busybox}"

PCIUTILS_SRC_DIR="${PCIUTILS_SRC_DIR:-${DAY24_ROOT}/third_party/pciutils}"  # 需按 docs/02_PREPARE_LSPCI.md 自行准备源码
GUEST_LSPCI_BIN="${GUEST_LSPCI_BIN:-${PCIUTILS_SRC_DIR}/lspci}"    # 需按 docs/02_PREPARE_LSPCI.md 自行构建

IVSHMEM_SIZE="${IVSHMEM_SIZE:-4M}"
IVSHMEM_DEVICE_ID_EXPECT="${IVSHMEM_DEVICE_ID_EXPECT:-1af4:1110}"
IVSHMEM_BACKEND_FILE="${IVSHMEM_BACKEND_FILE:-${WORKDIR}/runs/${RUN_ID}/ivshmem-day24.bin}"

MODULE_NAME="${MODULE_NAME:-day24_ivshmem_mmio}"
MODULE_FILE="${MODULE_FILE:-${DAY24_ROOT}/driver/day24_ivshmem_mmio.ko}"
TOOL_FILE="${TOOL_FILE:-${WORKDIR}/tools/aarch64/day24_mmio_tool}"
HOST_TOOL_FILE="${HOST_TOOL_FILE:-${WORKDIR}/tools/host/day24_mmio_tool}"

DAY24_EXPECTED_PAYLOAD="${DAY24_EXPECTED_PAYLOAD:-hello_day24_ivshmem}"
